---
import teaching from "../../data/teaching.json";
import Section from "./Section.astro";

interface Props {
    id: string;
}

const { id }: Props = Astro.props;
---

<Section id={id} title="Teaching" classNames={["left aligned text"]}>
    <div class="ui list">
        {
            teaching["institutions"].map((institution) => (
                <div class="item institution-entry">
                    <h3>{institution["name"]}</h3>
                    <div class="ui list">
                        {institution["courses"].map((course) => (
                            <div class="item teaching-entry">
                                <div class="header">
                                    {course["courseLink"] ? (
                                        <a
                                            href={course["courseLink"]}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {course["courseName"]}
                                            {course["courseNumber"]
                                                ? ` (${course["courseNumber"]})`
                                                : ""}
                                        </a>
                                    ) : (
                                        <span>
                                            {course["courseName"]}
                                            {course["courseNumber"]
                                                ? ` (${course["courseNumber"]})`
                                                : ""}
                                        </span>
                                    )}
                                </div>
                                {course["semesters"]?.length > 0 && (
                                    <div class="description">
                                        {course["semesters"].join(", ")}
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</Section>

<style>
    .header,
    .description {
        color: var(--text-color) !important;
    }

    h3 {
        margin: 0 0 0.5em;
    }

    .institution-entry {
        margin-bottom: 1em;
    }

    .institution-entry > .ui.list {
        margin-top: 0;
        padding: 0;
    }

    .institution-entry > .ui.list > .item:first-child {
        padding-top: 0;
    }

    .teaching-entry {
        margin-bottom: 1em;
    }
</style>
